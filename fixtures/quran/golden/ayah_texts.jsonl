{"surah": 1, "ayah": 1, "text": "أوَيت تَساكُن كن لهُم ثُشأوَ"}
{"surah": 1, "ayah": 2, "text": "شُأويَت يت اكَن بَلهمُ مثشُأو أوُ"}
{"surah": 1, "ayah": 3, "text": "ثش ويُت سُاكنَ"}
{"surah": 2, "ayah": 1, "text": "نَبلهُم هم شأُو يُتساَ اكنَبل بلَ"}
{"surah": 2, "ayah": 2, "text": "كن لهَم ثَشأوُ"}
{"surah": 3, "ayah": 1, "text": "أو تسُا كُنبلَ"}
{"surah": 3, "ayah": 2, "text": "شأَو يَتساُ اكنُبل بلُ"}
{"surah": 3, "ayah": 3, "text": "ثُشأوَ ويتَسا ساَ نَبل همثُش"}
{"surah": 3, "ayah": 4, "text": "مثشُأو أوُ تُسا كنبَل لهَمثشُ ثَش"}
{"surah": 4, "ayah": 1, "text": "نبُل هُمثشَ شأوَيت يتَ"}
{"surah": 4, "ayah": 2, "text": "كَنبلُ لهمُثش ثشُ وُيت ساكَن"}
{"surah": 5, "ayah": 1, "text": "أُويتَ تساَكن كنَ لَهم ثشأُو"}
{"surah": 5, "ayah": 2, "text": "شأوُيت يتُ اُكن بلهَم مثَشأوُ أَو"}
{"surah": 5, "ayah": 3, "text": "ثشَ وَيت ساكُن"}
