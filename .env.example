# Copy to `.env` (or supply these env vars directly) to configure Q-ai.
# Never commit a real `.env`.
#
# Also available via `QAI__…` nested mapping (see docs/architecture/config.md).

# Application
QAI_APP_MODE=local
QAI_DATA_DIR=~/.local/share/qai
QAI_LOCALE=en

# Server (Phase 0: health-only)
QAI_SERVER_BIND=127.0.0.1
QAI_SERVER_PORT=8737

# Storage
QAI_STORAGE__SQLITE__PATH=~/.local/share/qai/qai.db

# Logging / telemetry
QAI_LOG_LEVEL=info
QAI_TELEMETRY_ENABLED=false

# Example secrets (never the real value)
QAI_SECRETS__BACKEND=env
QAI_SECRETS__ENV_PREFIX=QAI_SECRET_
