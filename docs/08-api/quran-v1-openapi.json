    "/api/v1/quran/citations/{id}": {
      "get": {
        "operationId": "resolveCitation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "envelope of resolved citation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "404": {
            "description": "diagnostic body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Diagnostic"
                }
              }
            }
          }
        }
      }
