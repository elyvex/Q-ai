{
  "openapi": "3.1.0",
  "info": {
    "title": "Q-ai Quran Read API",
    "version": "v1",
    "description": "Deterministic, LLM-free canonical Quran lookup (Phase 1). Every response uses the stable envelope {api_version, data, meta}; errors use the Diagnostic body."
  },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "ok (text/plain)"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "ready (text/plain)"
          }
        }
      }
    },
    "/api/v1/meta": {
      "get": {
        "operationId": "serverMeta",
        "responses": {
          "200": {
            "description": "server name and build version in the API envelope; no configuration or corpus data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/quran/editions": {
      "get": {
        "operationId": "listEditions",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "envelope of edition descriptors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/quran/editions/{slug}": {
      "get": {
        "operationId": "getEdition",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "envelope of one edition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "404": {
            "description": "diagnostic body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Diagnostic"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/quran/surahs": {
      "get": {
        "operationId": "listSurahs",
        "parameters": [
          {
            "name": "edition",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "envelope of surah descriptors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/quran/surahs/{number}": {
      "get": {
        "operationId": "getSurah",
        "parameters": [
          {
            "name": "number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "edition",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "envelope of surah + ayah texts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "404": {
            "description": "diagnostic body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Diagnostic"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/quran/ayahs/{reference}": {
      "get": {
        "operationId": "getAyah",
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "edition",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "translations",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "glosses",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "tokens",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "envelope of ayah views; ETag from (text_hash, corpus_generation)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "sha256 over (text_hash, corpus_generation)",
                "schema": {
                  "type": "string"
                }
              },
              "Content-Language": {
                "description": "response language (ar for Arabic)",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "not modified (If-None-Match)"
          },
          "400": {
            "description": "diagnostic body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Diagnostic"
                }
              }
            }
          },
          "404": {
            "description": "diagnostic body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Diagnostic"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/quran/context/{reference}": {
      "get": {
        "operationId": "getContext",
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "boundary",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "surah",
                "juz",
                "ruku",
                "page",
                "none"
              ]
            }
          },
          {
            "name": "max_ayahs",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "envelope of context view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "400": {
            "description": "diagnostic body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Diagnostic"
                }
              }
            }
          },
          "404": {
            "description": "diagnostic body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Diagnostic"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/quran/divisions/{kind}/{number}": {
      "get": {
        "operationId": "getDivision",
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "edition",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
