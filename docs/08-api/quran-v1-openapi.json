                  },
                  "profile": {
                    "type": "string"
                  },
                  "rules": {
                    "type": "string"
                  },
                  "filters": {
                    "type": "object",
                    "description": "AND-combined metadata filters",
                    "properties": {
                      "surah": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        }
                      },
                      "juz": {
                        "type": "string",
                        "description": "`2` or `1-5`"
                      },
                      "page": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        }
                      },
                      "revelation_place": {
                        "type": "string",
                        "enum": [
                          "makki",
                          "madani"
                        ]
                      },
                      "global_range": {
                        "type": "string",
                        "description": "`10-99`"
                      }
                    }
                  },
                  "edition": {
                    "type": "string"
                  },
                  "match_mode": {
                    "type": "string"
                  },
                  "limit": {
                    "type": "integer"
                  },
                  "offset": {
                    "type": "integer"
                  },
                  "explain": {
                    "type": "boolean"
                  },
                  "highlight": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "envelope of SearchOutput",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "400": {
            "description": "diagnostic body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Diagnostic"
                }
              }
            }
          },
          "404": {
            "description": "diagnostic body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Diagnostic"
                }
              }
            }
          },
          "429": {
            "description": "diagnostic body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Diagnostic"
                }
              }
            }
          }
        }
      }
