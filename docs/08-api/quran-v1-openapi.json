    "/api/v1/quran/normalization/preview": {
      "post": {
        "operationId": "previewNormalization",
        "description": "Normalize text through a profile (default latest L3.diacritics) or an explicit rule list; returns derived text with its NormalizationTrace. Same pipeline as the CLI (AC-P2-39).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "profile": {
                    "type": "string"
                  },
                  "rules": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "envelope of preview with trace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "400": {
            "description": "diagnostic body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Diagnostic"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/quran/normalization/profiles": {
      "get": {
        "operationId": "listNormalizationProfiles",
        "description": "Seeded normalization profile catalog (L0-L8).",
        "responses": {
          "200": {
            "description": "envelope of profile catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        }
      }
    },
    "/debug/read/{edition}/{surah}": {
      "get": {
        "operationId": "debugRead",
        "description": "Labelled debug view (not the product UI): RTL HTML, no persistence.",
        "parameters": [
          {
            "name": "edition",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "surah",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML"
          }
        }
      }
    },
    "/api/v1/quran/search/exact": {
      "post": {
        "operationId": "searchExact",
        "description": "Exact search with no linguistic expansion (L0/L1). Zero-result Persian queries carry a hint warning, never a silent fold. Accept: text/event-stream streams one `hit` event per match plus a terminal `totals` event.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "field": {
                    "type": "string"
                  },
                  "filters": {
                    "type": "object",
                    "description": "AND-combined metadata filters",
                    "properties": {
                      "surah": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        }
                      },
                      "juz": {
                        "type": "string",
                        "description": "`2` or `1-5`"
                      },
                      "page": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        }
                      },
                      "revelation_place": {
                        "type": "string",
                        "enum": [
                          "makki",
                          "madani"
                        ]
                      },
                      "global_range": {
                        "type": "string",
                        "description": "`10-99`"
                      }
                    }
                  },
                  "edition": {
                    "type": "string"
                  },
                  "match_mode": {
                    "type": "string"
                  },
                  "limit": {
                    "type": "integer"
                  },
                  "offset": {
                    "type": "integer"
                  },
                  "explain": {
                    "type": "boolean"
                  },
                  "highlight": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "envelope of SearchOutput",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "400": {
            "description": "diagnostic body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Diagnostic"
                }
              }
            }
          },
          "404": {
            "description": "diagnostic body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Diagnostic"
                }
              }
            }
          },
          "429": {
            "description": "diagnostic body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Diagnostic"
                }
              }
            }
          }
        }
      }
    },
