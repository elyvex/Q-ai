    "/api/v1/quran/search/concatenated": {
      "post": {
        "operationId": "searchConcatenated",
        "description": "Space-insensitive skeleton search; every hit carries segmentation and spans_* flags. Accept: text/event-stream streams one `hit` event per match plus a terminal `totals` event.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "allow_cross_ayah": {
                    "type": "boolean"
                  },
                  "max_ayah_span": {
                    "type": "integer"
                  },
                  "filters": {
                    "type": "object",
                    "description": "AND-combined metadata filters",
                    "properties": {
                      "surah": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        }
                      },
                      "juz": {
                        "type": "string",
                        "description": "`2` or `1-5`"
                      },
                      "page": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        }
                      },
                      "revelation_place": {
                        "type": "string",
                        "enum": [
                          "makki",
                          "madani"
                        ]
                      },
                      "global_range": {
                        "type": "string",
                        "description": "`10-99`"
                      }
                    }
                  },
                  "edition": {
                    "type": "string"
                  },
                  "match_mode": {
