  "components": {
    "schemas": {
      "EditionMeta": {
        "type": "object",
        "description": "Edition descriptor carried in every envelope (AC-P1-14).",
        "required": [
          "slug",
          "version",
          "text_hash",
          "script",
          "riwayah",
          "numbering_scheme"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "text_hash": {
            "type": "string",
            "description": "hex sha256 of the canonical text"
          },
          "script": {
            "type": "string"
          },
          "riwayah": {
            "type": [
              "string",
              "null"
            ]
          },
          "numbering_scheme": {
            "type": "string"
          }
        }
      },
      "Meta": {
        "type": "object",
        "description": "Envelope metadata (AC-P1-14).",
        "required": [
          "edition",
          "corpus_generation",
          "canonical_reference",
          "deep_link",
          "execution_time_ms",
          "reproducibility",
          "warnings"
        ],
        "properties": {
          "edition": {
            "$ref": "#/components/schemas/EditionMeta"
          },
          "corpus_generation": {
            "type": "integer"
          },
          "canonical_reference": {
            "type": "string"
          },
          "deep_link": {
            "type": "string"
          },
          "execution_time_ms": {
            "type": "number"
          },
          "reproducibility": {
            "type": [
              "object",
              "null"
            ],
            "description": "checksum record (checksum key always present when computed)"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Envelope": {
        "type": "object",
        "description": "Stable response envelope: api_version + data + meta.",
        "required": [
          "api_version",
          "data",
          "meta"
        ],
        "properties": {
          "api_version": {
            "type": "string",
            "const": "v1"
          },
          "data": {
            "description": "endpoint payload (array, object, or value; see the operation description)"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "Diagnostic": {
        "type": "object",
        "description": "Phase-0 Diagnostic error body (AC-P1-14).",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "summary",
              "why"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "namespaced code, e.g. QAI-QUR-0307"
              },
              "summary": {
                "type": "string"
              },
              "location": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "why": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "remedy": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "next_command": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
