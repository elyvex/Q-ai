{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "doctor.v1",
  "description": "Stable JSON output of `qai doctor --json` (D0.14).",
  "type": "object",
  "required": ["checks"],
  "additionalProperties": false,
  "properties": {
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "summary", "remedy", "next_command"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Dotted check id, e.g. database.reachable."
          },
          "status": {
            "enum": ["pass", "warn", "fail", "skipped"]
          },
          "summary": {
            "type": "string"
          },
          "remedy": {
            "type": ["string", "null"],
            "description": "How to resolve a non-passing check."
          },
          "next_command": {
            "type": ["string", "null"],
            "description": "Suggested next CLI command."
          }
        }
      }
    }
  }
}
